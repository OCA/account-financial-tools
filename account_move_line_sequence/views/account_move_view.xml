<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_form__ext" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/tree//field[1]"
                position="before"
            >
                <field name="sequence_journal_item" widget="handle" />
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree" position="attributes">
                <attribute name="default_order">sequence_journal_item</attribute>
            </xpath>
        </field>
    </record>
</odoo>
