<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.unreconciled</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='bank_cash']/.." position="after">
                <block title="Sale Reconciling" id="sale_reconcile">
                    <setting
                        id="sale_lock_auto_reconcile"
                        help="Reconcile PO upon locking"
                        company_dependent="1"
                    >
                        <field name="sale_lock_auto_reconcile" />
                    </setting>
                    <setting id="sale_reconcile_account_id">
                        <field name="sale_reconcile_account_id" />
                    </setting>
                    <setting id="sale_reconcile_journal_id">
                        <field name="sale_reconcile_journal_id" />
                    </setting>
                    <setting id="sale_reconcile_tolerance">
                        <field name="sale_reconcile_tolerance" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
