<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="name">res.config.settings.form (in account_clearance_plan)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="account" position="inside">
                <block title="Clearance Plan" id="clearance_plan_settings">
                    <setting string="Default Clearance Plan Journal" id="clearance_plan_journal">
                        <field name="clearance_plan_journal_id"/>
                    </setting>
                    <setting string="Default Clearance Plan Move Line Name" id="clearance_plan_move_line">
                        <field name="clearance_plan_move_line_name"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>

</odoo>
