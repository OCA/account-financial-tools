<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="demo_asset_invoice" model="account.move">
        <field name="move_type">in_invoice</field>
        <field name="partner_id" ref="base.res_partner_12" />
        <field name="invoice_date">2026-01-01</field>
        <field name="ref">DEMO-ASSET-001</field>
        <field name="invoice_line_ids" eval="[Command.create({
            'name': 'Demo server equipment',
            'account_id': ref('demo_asset_account'),
            'asset_profile_id': ref('demo_asset_profile'),
            'quantity': 1.0,
            'price_unit': 4500.0,
        })]" />
    </record>
    <function
        model="account.move"
        name="action_post"
        eval="[ref('demo_asset_invoice')]"
    />
    <function
        model="account.asset"
        name="compute_depreciation_board"
        eval="obj().env.ref('account_asset_management.demo_asset_invoice').line_ids.asset_id.ids"
    />
</odoo>
