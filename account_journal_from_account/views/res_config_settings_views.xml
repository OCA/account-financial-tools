<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40" />
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="inside">
                <setting
                    id="post_bank_transactions_and_payments_setting"
                    string="Bank Journal:"
                >
                    <div class="content-group">
                        <div class="row mt8">
                            <label
                                for="inbound_payment_account_id"
                                class="col-lg-5 o_light_label"
                            />
                            <field
                                name="inbound_payment_account_id"
                                domain="[('deprecated', '=', False), ('account_type', 'in', ['asset_current', 'liability_current'])]"
                                options="{'no_create': True}"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="outbound_payment_account_id"
                                class="col-lg-5 o_light_label"
                            />
                            <field
                                name="outbound_payment_account_id"
                                domain="[('deprecated', '=', False), ('account_type', 'in', ['asset_current', 'liability_current'])]"
                                options="{'no_create': True}"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
