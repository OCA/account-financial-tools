<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_no_tax_recompute" model="ir.ui.view">
        <field name="name">account.move.form.no.tax.recompute</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab_entry']//group[@name='misc_group']/field[@name='checked']" position="after">
                <field name="no_tax_recompute"
                readonly="state != 'draft'"
                invisible="move_type != 'entry'"/>
            </xpath>
        </field>
    </record>
</odoo>
