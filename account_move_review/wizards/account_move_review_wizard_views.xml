<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_review_wizard_form" model="ir.ui.view">
        <field name="name">account.move.review.wizard.form</field>
        <field name="model">account.move.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset to Draft">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="payment_id" invisible="1"/>
                    <field name="recipient_user_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="notes" placeholder="Optional review notes..."/>
                </group>
                <footer>
                    <button name="action_confirm_reset_to_draft" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
