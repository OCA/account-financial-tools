<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="account_account_tag_view_form" model="ir.ui.view">
            <field name="name">account_account_tag.view.form</field>
            <field name="model">account.account.tag</field>
            <field name="arch" type="xml">
                <form string="Account Tag">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <label for="name" class="oe_edit_only" string="Tag Name"/>
                                <field name="name"/>
                                <span class="ml-2" invisible="active == True">
                                    (<span style="color:red;">Archived</span>)
                                </span>
                            </h1>
                        </div>
                        <header>
                            <label for="active" class="oe_edit_only" string="Status"/>
                            <field name="active" />
                        </header>
                        <separator string="Account Tag Definition" />
                        <group>
                            <field name="code" />
                            <field name="parent_id" />
                        </group>
                        <group>
                            <field name="applicability" />
                            <field name="color" widget="color_picker"/>
                            <field name="company_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                            <field name="country_id" />
                        </group>
                        <separator string="Child Tags" />
                        <group>
                            <field name="child_ids" nolabel="1">
                                <list string="">
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="country_id" />
                                    <field name="company_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="account_account_tag_view_list" model="ir.ui.view">
            <field name="name">account.account.tag.view.list</field>
            <field name="model">account.account.tag</field>
            <field name="arch" type="xml">
                <list string="Account Tags">
                    <field name="code" />
                    <field name="name" />
                    <field name="parent_id" />
                    <field name="applicability" />
                    <field name="color" widget="color_picker"/>
                    <field name="country_id" />
                    <field name="company_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                </list>
            </field>
        </record>

        <record id="action_account_account_tag" model="ir.actions.act_window">
            <field name="name">Account Tags</field>
            <field name="res_model">account.account.tag</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_ids" eval="[
                (5,0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_account_tag_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_account_tag_view_form')}),
            ]"/>
            <field name="help" type="html">
                <p>
                    <strong>Account Tags are used to categorize and label accounts in your chart of accounts.</strong>
                </p>
                <p>
                    They can be used for various purposes, such as reporting, filtering, and organizing accounts based on specific criteria.
                </p>
            </field>
        </record>
    
        <menuitem
            id="account_account_tag_menu"
            name="Account Tags"
            action="action_account_account_tag"
            groups="account.group_account_readonly"
            parent="account.account_account_menu"
            sequence="3"/>
    
    </data>
    

</odoo>
