<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form (deactivation date)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="domain">[
                    '|', ('deprecated', '=', False), ('deactivation_date', '&gt;', parent.date),
                    ('company_ids', 'parent_of', company_id),
                    ('account_type', 'not in', ('asset_receivable', 'liability_payable', 'off_balance'))
                ]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/form//field[@name='account_id']"
                position="attributes"
            >
                <attribute name="domain">[
                    '|', ('deprecated', '=', False), ('deactivation_date', '&gt;', parent.date),
                    ('company_ids', 'parent_of', company_id)
                ]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="domain">[
                    '|', ('deprecated', '=', False), ('deactivation_date', '&gt;', parent.date),
                    ('company_ids', 'parent_of', company_id)
                ]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']/form//field[@name='account_id']"
                position="attributes"
            >
                <attribute name="domain">[
                    '|', ('deprecated', '=', False), ('deactivation_date', '&gt;', parent.date),
                    ('company_ids', 'parent_of', company_id)
                ]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
