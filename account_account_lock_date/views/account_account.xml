<odoo>
    <record model="ir.ui.view" id="view_account_form">
        <field name="name">account.account.form (in account_account_lock_date)</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <field name="deprecated" position="after">
                <field name="lock_date" />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="view_account_list">
        <field name="name">account.account.list (in account_account_lock_date)</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <field name="allowed_journal_ids" position="after">
                <field name="lock_date" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
