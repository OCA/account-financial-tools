<odoo>
  <record id="account_account_modification_reason_list_view" model="ir.ui.view">
    <field name="name">account.account.modification.reason.list</field>
    <field name="model">account.account.modification.reason</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle" />
        <field name="name" />
      </list>
    </field>
  </record>
  <record id="account_account_modification_reason_search_view" model="ir.ui.view">
    <field name="name">account.account.modification.reason.search</field>
    <field name="model">account.account.modification.reason</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
      </search>
    </field>
  </record>
  <record
    id="account_account_modification_reason_act_window"
    model="ir.actions.act_window"
  >
    <field name="name">Account Modification Reasons</field>
    <field name="res_model">account.account.modification.reason</field>
    <field name="view_mode">list</field>
  </record>
  <menuitem
    id="account_account_modification_reason_menu"
    parent="account.account_account_menu"
    action="account_account_modification_reason_act_window"
    sequence="100"
  />
</odoo>
