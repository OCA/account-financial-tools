<odoo>
  <record id="account_account_modification_reason_wizard_form_view" model="ir.ui.view">
    <field name="name">account.account.modification.reason.wizard.form</field>
    <field name="model">account.account.modification.reason.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="reason_id" options="{'no_create': True, 'no_open': True}" />
        </group>
        <footer>
          <button string="Confirm" special="save" class="btn-primary" data-hotkey="q" />
          <button
            string="Cancel"
            special="cancel"
            class="btn-secondary"
            data-hotkey="x"
          />
        </footer>
      </form>
    </field>
  </record>
</odoo>
