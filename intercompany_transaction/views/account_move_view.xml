<odoo>
    <record id="view_move_form_inherit_entries" model="ir.ui.view">
        <field name="name">account.move.form.inherit.entries</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="delivery_date" position="after">
                <field name="is_intercompany_journal_entry" invisible="0" />
                <field name="intercompany_source_account_move_id" invisible="0" />
            </field>
            <xpath
                expr="//form/sheet/notebook/page[2]/field[@name='line_ids']/list/field[@name='account_id']"
                position="before"
            >
                <field
                    name="transfer_to_company_id"
                    domain="[('id', '!=', parent.company_id)]"
                    optional="show"
                    column_invisible="parent.move_type != 'entry' or parent.is_intercompany_journal_entry == True"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>

    <!-- Intercompany Transaction Entries -->
    <record id="action_intercompany_transaction_entries" model="ir.actions.act_window">
        <field name="name">Intercompany Transaction Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree" />
        <field name="search_view_id" ref="account.view_account_move_filter" />
        <field
            name="domain"
        >[('is_intercompany_journal_entry', '=', True)]</field>
        <field
            name="context"
        >{'default_move_type': 'entry', 'view_no_maturity': True, 'default_is_intercompany_journal_entry': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create an Intercompany Transaction journal entry
          </p>
        </field>
    </record>
</odoo>
